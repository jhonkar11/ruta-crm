VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA
VITE_VAPID_PUBLIC_KEY=TU_LLAVE_PUBLICA_VAPID

# --- Motor de IA (SOLO SERVIDOR: nunca se envía al navegador) ---
# Estas variables NO llevan prefijo VITE_ a propósito: Vite sólo expone al bundle
# del navegador las que empiezan por VITE_. La GEMINI_API_KEY se lee en el backend
# (api/gemini.js en Vercel, o el middleware de vite.config.js en desarrollo).
#
# En Vercel: Settings -> Environment Variables (marcas "Production", "Preview" y "Development")
GEMINI_API_KEY=TU_LLAVE_DE_GOOGLE_AI_STUDIO

# Validación de la sesión en el proxy. Recomendado (verificación local HS256, sin red).
# Alternativa: definir SUPABASE_URL + SUPABASE_ANON_KEY para validarla contra Supabase.
SUPABASE_JWT_SECRET=TU_SUPABASE_JWT_SECRET

# Opcional: con qué correo se permite gastar la cuota de Gemini (por defecto jhonka001@gmail.com)
SOPORTE_ADMIN_EMAIL=jhonka001@gmail.com

# Opcional: peticiones por minuto y por IP permitidas contra /api/gemini (por defecto 30)
GEMINI_RATE_LIMIT=30

# Opcional: fija el modelo de Gemini sin cambiar código. Si se omite, el servidor
# recorre la cadena gemini-3.8-flash -> 3.7 -> 3.6 -> 3.5 -> gemini-3.1-flash-lite
# hasta obtener respuesta (Google devuelve 503 "high demand" de forma intermitente).
# NO uses gemini-1.5-*, gemini-2.0-flash ni gemini-2.5-*: fueron retirados y dan HTTP 404.
GEMINI_MODEL=gemini-3.8-flash